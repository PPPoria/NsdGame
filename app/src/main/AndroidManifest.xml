<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NsdGames">
        <activity
            android:name=".ui.RoomsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          adjustResize：键盘弹起时给窗口发 IME inset。
          真正的内边距在 ChatActivity.onWindowInsetsChanged 里按 ime - systemBars 补，
          避免和 BaseActivity 已加的系统栏内边距叠加。

          configChanges：转屏不重建 Activity。重建会跑 onDestroy → session.close()，
          房主转个屏幕就把整屋人踢下线，不能接受。
        -->
        <activity
            android:name=".ui.ChatActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".ui.RoomsActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
