<?xml version="1.0" encoding="utf-8"?>
<!-- 座位面板：标题/说明 + 一组动作按钮（按钮由代码按座位状态生成） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_corner_top_24"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_m"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_xl">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_corner_pill"
        android:backgroundTint="?attr/colorOutlineVariant" />

    <TextView
        android:id="@+id/textSeatTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:textSize="@dimen/text_subtitle"
        android:textStyle="bold"
        tools:text="1 号位 · 小明" />

    <TextView
        android:id="@+id/textSeatDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_caption"
        tools:text="房主可以安排座次，座位顺序就是出手顺序" />

    <LinearLayout
        android:id="@+id/containerSeatActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:orientation="vertical" />

</LinearLayout>
