<?xml version="1.0" encoding="utf-8"?>
<!--
  盘子：线下是一块白瓷圆盘。这里是"上浅下深的圆"，
  里头的砖由 AzulPlateLayout 摆，盘本身只是一层背景。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="270"
        android:endColor="#C6D0DA"
        android:startColor="#F6F8FB" />
    <stroke
        android:width="1dp"
        android:color="#AFBAC6" />
</shape>
